+namespace {
+const std::string WINDOWS_DEVICE_ID_PREFIX = "72747677696e01";
+
+int hexValue(char value)
+{
+    if (value >= '0' && value <= '9') return value - '0';
+    if (value >= 'a' && value <= 'f') return value - 'a' + 10;
+    if (value >= 'A' && value <= 'F') return value - 'A' + 10;
+    return -1;
+}
+
+std::optional<std::string> decodeWindowsDeviceId(const std::string& value)
+{
+    if (value.rfind(WINDOWS_DEVICE_ID_PREFIX, 0) != 0) return std::nullopt;
+    const auto encoded = value.substr(WINDOWS_DEVICE_ID_PREFIX.size());
+    if (encoded.empty() || encoded.size() % 2 != 0) return std::nullopt;
+
+    std::string decoded;
+    decoded.reserve(encoded.size() / 2);
+    for (size_t index = 0; index < encoded.size(); index += 2)
+    {
+        const auto high = hexValue(encoded[index]);
+        const auto low = hexValue(encoded[index + 1]);
+        if (high < 0 || low < 0) return std::nullopt;
+        decoded.push_back(static_cast<char>((high << 4) | low));
+    }
+    return decoded;
+}
+}
